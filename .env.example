# ==========================================
# PAPERLY — Cloudflare & AI Environment Config
# ==========================================

# Cloudflare D1 Database & Worker Binding
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
D1_DATABASE_ID=your_d1_database_id_here

# Cloudflare R2 Storage (Private by default for magazine assets)
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=paperly-media-assets

# Cloudflare JWT Session Secret
JWT_SECRET=paperly_jwt_super_secret_editorial_key_2026

# Google Gemini API Key (Server-side only — never exposed to client)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Base App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

